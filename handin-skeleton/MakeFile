# Makefile for KMeans implementations
# Builds CPU, Thrust, CUDA (basic), and CUDA (shared memory) versions

CXX = g++
NVCC = nvcc

CXXFLAGS = -O2 -std=c++17
NVCCFLAGS = -O2 -std=c++14

BIN_DIR = bin

# Targets
all: $(BIN_DIR)/kmeans_cpu $(BIN_DIR)/kmeans_thrust $(BIN_DIR)/kmeans_cuda_basic $(BIN_DIR)/kmeans_cuda_shmem

# Ensure bin directory exists
$(BIN_DIR):
	mkdir -p $(BIN_DIR)

# Sequential (CPU) version
$(BIN_DIR)/kmeans_cpu: main.cpp kmeans_cpu.cpp kmeans.h | $(BIN_DIR)
	$(CXX) $(CXXFLAGS) -o $@ main.cpp kmeans_cpu.cpp

# Thrust version
$(BIN_DIR)/kmeans_thrust: main.cpp kmeans_thrust.cu kmeans.h | $(BIN_DIR)
	$(NVCC) $(NVCCFLAGS) -o $@ main.cpp kmeans_thrust.cu

# CUDA basic version
$(BIN_DIR)/kmeans_cuda_basic: main.cpp kmeans_cuda_basic.cu kmeans.h | $(BIN_DIR)
	$(NVCC) $(NVCCFLAGS) -o $@ main.cpp kmeans_cuda_basic.cu

# CUDA shared memory version
$(BIN_DIR)/kmeans_cuda_shmem: main.cpp kmeans_cuda_shmem.cu kmeans.h | $(BIN_DIR)
	$(NVCC) $(NVCCFLAGS) -o $@ main.cpp kmeans_cuda_shmem.cu

# Clean up
clean:
	rm -rf $(BIN_DIR)

.PHONY: all clean
